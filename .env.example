# AWS Bedrock - accès à activer par région, cf. docs/private/3-FEUILLE-DE-ROUTE.md J1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# IDs des modèles Bedrock : IDs de profil d'inférence Geo/Global (ex.
# eu.<provider>.<modele> pour du EU-only)
MODEL_VOLUME=
MODEL_ESCALADE=
# Cohere embed-v4 via Bedrock (§4.2) - distinct de COHERE_API_KEY plus bas,
# qui reste réservé au reranking (accès API Cohere direct)
MODEL_EMBEDDING=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chaîne de connexion Postgres directe (migrations)
DATABASE_URL=

# Cohere (reranking)
COHERE_API_KEY=

# Token partagé exigé par l'API et le MCP (fix, 2026-08-19) - même valeur des
# deux côtés. Requis pour packages/api et packages/mcp.
LEGIRAG_ACCESS_TOKEN=

# Front end (packages/web) - variables serveur uniquement, jamais
# NEXT_PUBLIC_* : le navigateur n'appelle plus l'API directement, ces
# valeurs ne doivent jamais atteindre le bundle client. À régler côté
# serveur Vercel, pas en local dans ce fichier partagé avec l'API/le MCP.
LEGIRAG_API_URL=
# Même valeur que LEGIRAG_ACCESS_TOKEN ci-dessus.

# Mode dev uniquement (fix, 2026-08-20) - décommenter pour lancer
# `packages/web` seul, sans api/agent/Bedrock/Cohere/Supabase, avec des
# réponses entièrement mockées (aucun appel réel, donc aucun coût). Sans
# effet si NODE_ENV=production. Aucune des variables ci-dessus n'est requise
# quand ce flag est actif.
# LEGIRAG_MOCK_BACKEND=true
