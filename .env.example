# AWS Bedrock - accès à activer par région, cf. docs/private/3-FEUILLE-DE-ROUTE.md J1
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_REGION=

# IDs des modèles Bedrock : IDs de profil d'inférence Geo/Global (ex.
# eu.<provider>.<modele> pour du EU-only)
MODEL_VOLUME=
MODEL_ESCALADE=
# Cohere embed-v4 via Bedrock (§4.2) - distinct de COHERE_API_KEY plus bas,
# qui reste réservé au reranking (accès API Cohere direct)
MODEL_EMBEDDING=

# Supabase
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
# Chaîne de connexion Postgres directe (migrations)
DATABASE_URL=

# Cohere (reranking)
COHERE_API_KEY=
