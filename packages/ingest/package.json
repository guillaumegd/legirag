{
  "name": "@legirag/ingest",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -b",
    "inspect:cold": "tsx src/cold/inspect-cold.ts",
    "fetch:cold": "tsx src/cold/fetch-cold.ts",
    "validate:section-paths": "tsx src/cold/validate-section-paths.ts",
    "validate:subdivisions": "tsx src/cold/validate-subdivisions.ts",
    "validate:chunking": "tsx src/cold/validate-chunking.ts",
    "validate:renvois-accuracy": "tsx src/cold/validate-renvois-accuracy.ts",
    "validate:renvois": "tsx src/cold/validate-renvois.ts",
    "load:corpus": "tsx --env-file=../../.env src/cold/load-corpus.ts",
    "validate:load": "tsx --env-file=../../.env src/cold/validate-load.ts",
    "load:renvois": "tsx --env-file=../../.env src/cold/load-renvois.ts",
    "validate:renvois-load": "tsx --env-file=../../.env src/cold/validate-renvois-load.ts"
  },
  "dependencies": {
    "@legirag/shared": "workspace:*",
    "hyparquet": "^1.28.1",
    "pg": "^8.23.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/pg": "^8.21.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}
