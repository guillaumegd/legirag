# URL de l'API (packages/api) et token partagé (fix, 2026-08-19) - variables
# serveur uniquement, jamais NEXT_PUBLIC_* : le navigateur n'appelle plus
# l'API directement, ces valeurs ne doivent jamais atteindre le bundle
# client (voir app/api/* et lib/api-proxy.ts).
LEGIRAG_API_URL=http://localhost:3000
LEGIRAG_ACCESS_TOKEN=
